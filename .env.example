# Server-only PostgreSQL URL. Set this to a real database; do not use a placeholder.
# Examples and provider-specific URLs belong in your private .env.local, never in Git.
DATABASE_URL=
# Required to sign session cookies. Generate a unique secret; do not reuse a database password.
SESSION_SECRET=
# Required only for the protected /api/cron/tick route and database scheduler.
CRON_SECRET=
# Set true only for the fictional demo journey.
DEMO_MODE=false
# npm run seed truncates core tables. Enable only for a fresh, disposable demo database.
ALLOW_DEMO_SEED=false
# Optional advisory matching, eligibility/conflict explanations and ticket summaries.
GROQ_API_KEY=
AI_TEXT_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=qwen/qwen3.8-27b
