# Firebase project ID from Firebase Console > Project settings > General.
FIREBASE_PROJECT_ID=
# Locally, prefer a service-account JSON file outside the repository and set
# GOOGLE_APPLICATION_CREDENTIALS to its absolute path. Render may use the inline
# JSON secret below (keep the value private and preserve JSON escaping).
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# One-time empty-project bootstrap only. Keep these local and remove them after use.
LABLOOP_ADMIN_EMAIL=
LABLOOP_ADMIN_PASSWORD=
LABLOOP_ADMIN_NAME=
LABLOOP_HOST_ORG_NAME=
LABLOOP_HOST_EMAIL_DOMAIN=

# Required: generate a unique random value for signing LabLoop session cookies.
SESSION_SECRET=
# Required for the protected /api/cron/tick route when scheduling is enabled.
CRON_SECRET=

# Optional advisory matching, eligibility/conflict explanations and summaries.
GROQ_API_KEY=
AI_TEXT_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=qwen/qwen3.8-27b
